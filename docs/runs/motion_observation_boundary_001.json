        "artifacts/motion_observation_boundary_001/run002/summary.json",
        "artifacts/motion_observation_boundary_001/run002/measurements.json"
      ]
    },
    "common_depth_formula_premise_boundary": {
      "component": "common-depth lateral-span approximation",
      "expected": "Keeping the projected lateral span should explain centered orientation change, but it should be rejected when endpoint depths materially differ.",
      "observed": "All six centered-yaw pairs covered the common-depth prediction; all 18 offset-yaw or depth-skew pairs excluded it.",
      "expectation_met": true,
      "evidence_decision": "accepted",
      "implication": "Orientation and per-endpoint depth are separately observable in this grid and should not be collapsed into one width-over-center-depth formula.",
      "evidence_refs": [
        "docs/runs/motion_observation_boundary_001.md",
        "artifacts/motion_observation_boundary_001/run002/summary.json",
